function findfile(){
    selected=$(find ~/Dropbox ~/github ~/marc ~/mnt ~/Desktop  -type f | fzf)
    cd $(dirname "$selected")
}

function findfolder(){
    selected=$(find ~/Dropbox ~/github ~/marc ~/mnt ~/Desktop  -type d | fzf)
    cd $selected
}

