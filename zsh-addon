eval "$(zoxide init zsh)"

# Load the command line editor widget
autoload -Uz edit-command-line
zle -N edit-command-line

# Bind it to Ctrl+X, Ctrl+E
bindkey '^X^E' edit-command-line

# Function to copy the current line buffer to the system clipboard
copy-earlier-word-or-line() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    echo -n "$BUFFER" | pbcopy
  elif command -v xclip >/dev/null 2>&1; then
    echo -n "$BUFFER" | xclip -selection clipboard
  elif command -v wl-copy >/dev/null 2>&1; then
    echo -n "$BUFFER" | wl-copy
  fi
}

# Register the widget and bind it to Ctrl+O
zle -N copy-earlier-word-or-line
bindkey '^O' copy-earlier-word-or-line
