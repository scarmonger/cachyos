#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(find ~/Dropbox/notes -mindepth 1 -maxdepth 15 -type f | fzf)
fi

if [[ -z $selected ]]; then
  exit 0
fi

# 1. Format as Markdown link or image based on extension
filename=$(basename "$selected")
extension="${filename##*.}"
extension=$(echo "$extension" | tr '[:upper:]' '[:lower:]')

if [[ "$extension" == "jpg" || "$extension" == "jpeg" || "$extension" == "png" ]]; then
  markdown_link="![%$filename]($selected)" # Wait, let's keep it clean:
else
  markdown_link="[$filename]($selected)"
fi

# Fix the image tag format to ensure it uses proper syntax
if [[ "$extension" == "jpg" || "$extension" == "jpeg" || "$extension" == "png" ]]; then
  markdown_link="![$filename]($selected)"
else
  markdown_link="[$filename]($selected)"
fi

# Cross-platform clipboard support (macOS pbcopy, Wayland wl-copy, X11 xclip/xsel)
if command -v pbcopy &>/dev/null; then
  echo -n "$markdown_link" | pbcopy
elif command -v wl-copy &>/dev/null; then
  echo -n "$markdown_link" | wl-copy
elif command -v xclip &>/dev/null; then
  echo -n "$markdown_link" | xclip -selection clipboard
elif command -v xsel &>/dev/null; then
  echo -n "$markdown_link" | xsel --clipboard --input
fi

